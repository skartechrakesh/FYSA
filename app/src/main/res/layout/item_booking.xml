<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bgColor">

    <!-- Booking Name -->
    <TextView
        android:id="@+id/tvBookingName"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/textPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Booking Type / Space Type -->
    <TextView
        android:id="@+id/tvBookingType"
        android:textColor="@color/textPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Booking Date -->
    <TextView
        android:id="@+id/tvBookingDate"
        android:textColor="@color/textPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Booking Time -->
    <TextView
        android:id="@+id/tvCreatedAt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Created At: "
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_marginTop="4dp"/>

    <!-- Booking Status -->
    <TextView
        android:id="@+id/tvBookingStatus"
        android:textColor="@color/textPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Cancel Visit Button -->
    <Button
        android:id="@+id/btnAction"
        android:text="Cancel Visit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/btnSecondary"
        android:textColor="@color/btnTextPrimary"/>
</LinearLayout>
