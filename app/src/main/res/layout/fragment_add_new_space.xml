<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgColor"
    tools:context=".AddNewSpaceFragment">

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnHostel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:text="@string/hostel"
                android:textColor="@color/btnOutlineText"
                app:icon="@drawable/ic_add_space"
                app:iconTint="@color/btnOutlineText"
                app:strokeColor="@color/linkText"
                tools:ignore="VisualLintButtonSize" />

            <Button
                android:id="@+id/btnPg"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:text="@string/pg"
                android:textColor="@color/btnOutlineText"
                app:icon="@drawable/ic_add_space"
                app:iconTint="@color/btnOutlineText"
                app:strokeColor="@color/linkText"
                tools:ignore="VisualLintButtonSize" />

            <Button
                android:id="@+id/btnBachelorRoom"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:text="@string/bachelor_room"
                android:textColor="@color/btnOutlineText"
                app:icon="@drawable/ic_add_space"
                app:iconTint="@color/btnOutlineText"
                app:strokeColor="@color/linkText"
                tools:ignore="VisualLintButtonSize" />

            <Button
                android:id="@+id/btnIndividualHouse"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:text="@string/individual_house"
                android:textColor="@color/btnOutlineText"
                app:icon="@drawable/ic_add_space"
                app:iconTint="@color/btnOutlineText"
                app:strokeColor="@color/linkText"
                tools:ignore="VisualLintButtonSize" />

            <Button
                android:id="@+id/btnFlat"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:text="@string/flat"
                android:textColor="@color/btnOutlineText"
                app:icon="@drawable/ic_add_space"
                app:iconTint="@color/btnOutlineText"
                app:strokeColor="@color/linkText"
                tools:ignore="VisualLintButtonSize" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
