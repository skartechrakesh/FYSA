<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".AddNewSpaceFragment">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHostel"
                style="?attr/materialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="?attr/buttonColor"
                android:elevation="4dp"
                android:fontFamily="sans-serif-black"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/hostel"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_add_space"
                app:iconGravity="top"
                app:iconTint="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPg"
                style="?attr/materialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="?attr/buttonColor"
                android:elevation="4dp"
                android:fontFamily="sans-serif-black"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/pg"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_add_space"
                app:iconGravity="top"
                app:iconTint="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBachelorRoom"
                style="?attr/materialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="?attr/buttonColor"
                android:elevation="4dp"
                android:fontFamily="sans-serif-black"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/bachelor_room"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_add_space"
                app:iconGravity="top"
                app:iconTint="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIndividualHouse"
                style="?attr/materialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="?attr/buttonColor"
                android:elevation="4dp"
                android:fontFamily="sans-serif-black"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/individual_house"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_add_space"
                app:iconGravity="top"
                app:iconTint="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFlat"
                style="?attr/materialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="?attr/buttonColor"
                android:elevation="4dp"
                android:fontFamily="sans-serif-black"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/flat"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_add_space"
                app:iconGravity="top"
                app:iconTint="?attr/colorOnSurface" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>