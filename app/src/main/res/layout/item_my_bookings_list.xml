<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/colorBackground">

    <!-- Booking Name -->
    <TextView
        android:id="@+id/tvBookingName"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Booking Type / Space Type -->
    <TextView
        android:id="@+id/tvBookingType"
        android:textColor="?attr/colorOnSurface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Booking Date -->
    <TextView
        android:id="@+id/tvBookingDate"
        android:textColor="?attr/colorOnSurface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Booking Status -->
    <TextView
        android:id="@+id/tvBookingStatus"
        android:textColor="?attr/colorSuccess"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <!-- Cancel Visit Button -->
        <Button
            android:id="@+id/btnAction"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/colorSecondary"
            android:layout_marginEnd="12dp"
            android:text="@string/cancel_visit"
            android:textColor="@color/textPrimary" />

        <!-- Cancel Visit Button -->
        <Button
            android:id="@+id/btnDirections"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/colorSuccess"
            android:text="Open in Maps"
            android:textColor="@color/textPrimary" />
    </LinearLayout>
</LinearLayout>
